{
  "$schema": "../secrets-policy.schema.json",
  "schemaVersion": 1,
  "project": "example-service",
  "repository": "example/example-service",
  "repositoryVisibility": "private",
  "forkExposure": "none",
  "classification": "doppler",
  "doppler": {
    "project": "example-service",
    "configs": [
      "dev",
      "stg",
      "prd"
    ]
  },
  "ci": {
    "runner": "owned-linux",
    "identity": "doppler-service-token",
    "injection": "per-job-doppler-fetch"
  },
  "exceptions": [],
  "review": {
    "owner": "project-maintainer",
    "cadenceDays": 90
  }
}
